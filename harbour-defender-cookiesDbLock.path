[Unit]
Description=Lock the cookies.sqlite db, make it immutable, on request from Defender
#user units do NOT work for system: After=pre-user-session.target
DefaultDependencies=no
After=sailfish-unlock-agent.service
After=decrypt-home_encrypted.service

[Path]
PathExists=/home/nemo/.cache/leinchen.peter/harbour-defender/cookiesDbLock
PathExists=/home/defaultuser/.cache/leinchen.peter/harbour-defender/cookiesDbLock

[Install]
#user units do NOT work for system: WantedBy=default.target
#    encrypted devices: WantedBy = sailfish-unlock-agent.service
#    encrypted devices: WantedBy = decrypt-home_encrypted.service
#NOT encrypted devices: WantedBy = default.target
WantedBy=sailfish-unlock-agent.service
