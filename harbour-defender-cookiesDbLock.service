[Unit]
Description=Lock the cookies.sqlite db (make it immutable) on request from Defender

[Service]
Type=oneshot
ExecStart=/bin/sh -c "FILE_PATH=`cat /tmp/defender/dir`/.cache/leinchen.peter/harbour-defender; \
                      FLAG=`cat $FILE_PATH/cookiesDbLock`; \
                      SQLITE_PATH=`cat /tmp/defender/dir`/.local/share/org.sailfishos/browser/.mozilla/cookies.sqlite; \
                      chattr $FLAG $SQLITE_PATH; \
                      rm -f $FILE_PATH/cookiesDbLock;"
