[Unit]
Description=Change the update interval time on request from Defender

[Service]
Type=oneshot
ExecStart=/bin/sh -c "FILE_PATH=`cat /tmp/defender/dir`/.cache/leinchen.peter/harbour-defender; \
                      INTERVAL=`cat $FILE_PATH/updInterval`; \
                      sed -e \"s/^OnCalendar=.*/OnCalendar=$INTERVAL/\" -i /etc/systemd/system/harbour-defender.timer; \
                      systemctl daemon-reload; \
                      systemctl restart harbour-defender.timer; \
                      rm -f $FILE_PATH/updInterval;"
